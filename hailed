#!/usr/bin/env python3
"""Hailed desktop launcher: GTK3 + WebKit2GTK 4.1 window serving the game."""
import os, sys, re, mimetypes, threading, http.server, socketserver, functools, subprocess, urllib.parse
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gtk, Gdk, GLib, Gio, WebKit2

ROOT = os.path.dirname(os.path.realpath(__file__))
DATA = os.path.expanduser("~/.local/share/hailed")
MIMES = {".js": "text/javascript", ".mjs": "text/javascript", ".html": "text/html",
         ".css": "text/css", ".json": "application/json", ".svg": "image/svg+xml",
         ".png": "image/png", ".wasm": "application/wasm", ".glsl": "text/plain"}
USE_HTTP = os.environ.get("HAILED_HTTP") == "1"

def mime_of(path):
    ext = os.path.splitext(path)[1].lower()
    return MIMES.get(ext) or mimetypes.guess_type(path)[0] or "application/octet-stream"

def parse_args(argv):
    shot, delay, query = None, 4.0, []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--screenshot" and i + 1 < len(argv):
            shot = argv[i + 1]; i += 2
        elif a == "--delay" and i + 1 < len(argv):
            delay = float(argv[i + 1]); i += 2
        elif "=" in a:
            query.append(a); i += 1
        else:
            i += 1
    return shot, delay, "&".join(query)

def safe_path(rel):
    rel = rel.split("?")[0].split("#")[0].lstrip("/") or "index.html"
    full = os.path.realpath(os.path.join(ROOT, rel))
    if not (full == ROOT or full.startswith(ROOT + os.sep)) or not os.path.isfile(full):
        return None
    return full

# ---- Rocky's laptop voice: espeak-ng rendered on demand (cached by text + mood) ----
ESPEAK = "/usr/bin/espeak-ng"
TTS_MOODS = {"still": (155, 38), "excited": (185, 55), "slumped": (130, 28)}
TTS_CACHE = {}

def tts_audio(query):
    """Render (or return cached) WAV bytes for __tts?text=...&mood=...; None on any failure."""
    q = urllib.parse.parse_qs(query or "", keep_blank_values=True)
    text = (q.get("text") or [""])[0]
    mood = (q.get("mood") or ["still"])[0]
    text = re.sub(r"[\x00-\x1f\x7f-\x9f]", "", text)[:300]
    if not text.strip():
        return None
    if mood not in TTS_MOODS:
        mood = "still"
    key = (text, mood)
    if key in TTS_CACHE:
        return TTS_CACHE[key]
    if not os.path.exists(ESPEAK):
        return None
    speed, pitch = TTS_MOODS[mood]
    try:
        p = subprocess.run([ESPEAK, "-v", "en-us+m3", "-s", str(speed), "-p", str(pitch),
                            "-a", "160", "--stdout", "--", text],
                           capture_output=True, timeout=10)
    except Exception:
        return None
    if p.returncode != 0 or not p.stdout:
        return None
    TTS_CACHE[key] = p.stdout
    return p.stdout

def start_http():
    class H(http.server.SimpleHTTPRequestHandler):
        def log_message(self, *a): pass
        def guess_type(self, p): return mime_of(p)
        def do_GET(self):
            u = urllib.parse.urlparse(self.path)
            if u.path == "/__tts":
                data = tts_audio(u.query)
                if data is None:
                    self.send_error(404)
                    return
                self.send_response(200)
                self.send_header("Content-Type", "audio/wav")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
            super().do_GET()
    handler = functools.partial(H, directory=ROOT)
    srv = socketserver.ThreadingTCPServer(("127.0.0.1", 0), handler)
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv

def main():
    shot, delay, query = parse_args(sys.argv[1:])
    os.makedirs(DATA, exist_ok=True)
    dm = WebKit2.WebsiteDataManager(base_data_directory=DATA,
                                    base_cache_directory=os.path.join(DATA, "cache"))
    ctx = WebKit2.WebContext.new_with_website_data_manager(dm)
    srv = None
    if USE_HTTP:
        srv = start_http()
        base = "http://127.0.0.1:%d/index.html" % srv.server_address[1]
    else:
        def on_scheme(req):
            path = req.get_path()
            if path.split("?")[0] == "/__tts":
                data = tts_audio(urllib.parse.urlparse(req.get_uri() or "").query)
                if data is None:
                    req.finish_error(GLib.Error.new_literal(Gio.io_error_quark(), "not found", Gio.IOErrorEnum.NOT_FOUND))
                    return
                stream = Gio.MemoryInputStream.new_from_bytes(GLib.Bytes.new(data))
                req.finish(stream, len(data), "audio/wav")
                return
            full = safe_path(path)
            if not full:
                req.finish_error(GLib.Error.new_literal(Gio.io_error_quark(), "not found", Gio.IOErrorEnum.NOT_FOUND))
                return
            with open(full, "rb") as f:
                data = f.read()
            stream = Gio.MemoryInputStream.new_from_bytes(GLib.Bytes.new(data))
            req.finish(stream, len(data), mime_of(full))
        ctx.register_uri_scheme("hailed", on_scheme)
        sm = ctx.get_security_manager()
        for fn in ("register_uri_scheme_as_secure", "register_uri_scheme_as_cors_enabled", "register_uri_scheme_as_local"):
            try: getattr(sm, fn)("hailed")
            except Exception: pass
        base = "hailed://app/index.html"

    ucm = WebKit2.UserContentManager()
    ucm.register_script_message_handler("hailed")
    view = WebKit2.WebView(web_context=ctx, user_content_manager=ucm)
    s = view.get_settings()
    s.set_enable_webgl(True)
    s.set_hardware_acceleration_policy(WebKit2.HardwareAccelerationPolicy.ALWAYS)
    s.set_enable_javascript(True)
    s.set_enable_html5_local_storage(True)
    s.set_allow_file_access_from_file_urls(True)
    s.set_media_playback_requires_user_gesture(False)
    debug = os.environ.get("HAILED_DEBUG") == "1"
    s.set_enable_developer_extras(debug)
    s.set_enable_write_console_messages_to_stdout(debug or bool(shot))
    view.set_background_color(Gdk.RGBA(0.01, 0.02, 0.04, 1))

    win = Gtk.Window(title="Hailed")
    # HAILED_SIZE=WxH overrides the headless/screenshot viewport (used by the tutorial audit: ?tutaudit=1)
    try: sw, sh = [int(v) for v in os.environ.get("HAILED_SIZE", "1600x900").lower().split("x")]
    except Exception: sw, sh = 1600, 900
    win.set_default_size(sw, sh)
    if shot or os.environ.get("HAILED_SHOTDIR"):
        view.set_size_request(sw, sh)   # deterministic size for --screenshot under Xvfb (no window manager)
    win.add(view)
    win.connect("destroy", Gtk.main_quit)

    def on_msg(_m, result):
        try:
            txt = result.get_js_value().to_string()
        except Exception:
            txt = ""
        if txt == "quit":
            win.close()
        elif txt == "fullscreen":
            toggle_fs()
        elif txt.startswith("shot:") and os.environ.get("HAILED_SHOTDIR"):   # debug: scripted playtests ask for snapshots
            name = os.path.basename(txt[5:]) or "shot"
            def done(v, res, *_a):
                try:
                    v.get_snapshot_finish(res).write_to_png(os.path.join(os.environ["HAILED_SHOTDIR"], name + ".png"))
                except Exception as e:
                    print("snapshot failed:", e, file=sys.stderr)
            view.get_snapshot(WebKit2.SnapshotRegion.VISIBLE, WebKit2.SnapshotOptions.NONE, None, done)
    ucm.connect("script-message-received::hailed", on_msg)

    state = {"fs": False}
    def toggle_fs():
        if state["fs"]: win.unfullscreen()
        else: win.fullscreen()
        state["fs"] = not state["fs"]
    def on_key(_w, ev):
        if ev.keyval == Gdk.KEY_F11:
            toggle_fs(); return True
        return False
    win.connect("key-press-event", on_key)

    def on_perm(_v, req):
        req.allow(); return True
    view.connect("permission-request", on_perm)

    url = base + ("?" + query if query else "")
    view.load_uri(url)
    win.show_all()
    if shot or os.environ.get("HAILED_SHOTDIR"):
        win.set_resizable(False); win.resize(sw, sh)   # exact viewport for headless runs (no window manager to negotiate with)

    if shot:
        def snap():
            def done(v, res):
                try:
                    surf = v.get_snapshot_finish(res)
                    surf.write_to_png(shot)
                    print("screenshot written:", shot)
                except Exception as e:
                    print("snapshot failed:", e, file=sys.stderr)
                Gtk.main_quit()
            view.get_snapshot(WebKit2.SnapshotRegion.VISIBLE, WebKit2.SnapshotOptions.NONE, None, done)
            return False
        GLib.timeout_add(int(delay * 1000), snap)
    Gtk.main()
    if srv: srv.shutdown()

if __name__ == "__main__":
    main()
